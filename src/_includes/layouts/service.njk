---
layout: layouts/base.njk
---

<!-- Service Hero Section -->
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-content">
      <!-- Badges Top (Matching furnace repair pros) -->
      <div class="hero-badges-top">
        <span class="hero-pill-active"><span class="badge-dot"></span> Priority Roofing Network Active</span>
        <span class="hero-pill-fast">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          CERTIFIED {{ service.name | upper }}
        </span>
      </div>

      <h1>{{ service.name }}</h1>

      <!-- Rich Niche Paragraph (Matching furnace repair pros depth) -->
      <p class="hero-lead">
        American Shingle Co. connects homeowners nationwide with licensed and insured roofing specialists dedicated to precision {{ service.name | lower }}. Our partner network provides prompt local coordination with typical contractor response times of 30 to 90 minutes &mdash; delivering code-compliant installation, expert deck and ventilation integration, and manufacturer-backed warranties.
      </p>

      <div class="hero-trust-pills">
        <span class="trust-pill"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> Lifespan: {{ service.lifespan }}</span>
        <span class="trust-pill"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg> Impact: {{ service.impactRating }}</span>
        <span class="trust-pill"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path></svg> Fire: {{ service.fireRating }}</span>
      </div>

      <!-- Action Buttons (Matching furnace repair pros) -->
      <div class="hero-cta-group">
        <a href="tel:{{ site.phoneTel }}" class="hero-btn-call">
          <div class="hero-btn-call-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"></path></svg>
          </div>
          <div class="hero-btn-call-text">
            <span class="hero-btn-call-sub">CALL 24/7 INTAKE</span>
            <span class="hero-btn-call-num">{{ site.phoneDisplay }}</span>
          </div>
        </a>
        <a href="/states/" class="hero-btn-outline">
          <span>Find Local Roofers &rarr;</span>
        </a>
      </div>
    </div>

    <div>
      <div class="hero-img-wrapper" style="position: relative;">
        <img src="{{ service.image }}" alt="{{ service.name }}" class="hero-main-img" width="900" height="650">
        <div class="hero-img-badge">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          <span>Response Time: 30 to 90 Mins</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Stats Ribbon below Hero (Matching furnace repair pros) -->
<div class="hero-stats-strip">
  <div class="container hero-stats-grid">
    <div class="hero-stat-item">
      <span class="hero-stat-value">30 to 90 Min</span>
      <span class="hero-stat-label">Average Partner Response</span>
    </div>
    <div class="hero-stat-item">
      <span class="hero-stat-value">{{ service.lifespan }}</span>
      <span class="hero-stat-label">Expected Material Lifespan</span>
    </div>
    <div class="hero-stat-item">
      <span class="hero-stat-value">{{ service.windRating }}</span>
      <span class="hero-stat-label">Wind Velocity Rating</span>
    </div>
    <div class="hero-stat-item">
      <span class="hero-stat-value">Class {{ service.impactRating }}</span>
      <span class="hero-stat-label">Hail Impact Resistance</span>
    </div>
  </div>
</div>

<!-- Content Body -->
<section style="padding: 3.5rem 0;">
  <div class="container" style="max-width: 900px;">
    
    <!-- Direct Answer Box -->
    <div class="direct-answer">
      <strong>Quick Answer:</strong> {{ service.name }} provides an estimated service life of {{ service.lifespan }} with an average installed investment range of {{ service.costRange }}. It is ideally suited for {{ service.bestClimates }}
    </div>

    {{ content | safe }}

    <!-- Key Specifications Table -->
    <h2>Engineering & Code Specifications</h2>
    <p>Professional installation standards require strict adherence to manufacturer specifications and adopted local building codes:</p>
    
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Specification Attribute</th>
            <th>Standard Requirement</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Material Composition</strong></td>
            <td>{{ service.specifications.matType }}</td>
          </tr>
          <tr>
            <td><strong>Fasteners & Schedule</strong></td>
            <td>{{ service.specifications.fasteners }}</td>
          </tr>
          <tr>
            <td><strong>Substrate Roof Decking</strong></td>
            <td>{{ service.specifications.deckRequirement }}</td>
          </tr>
          <tr>
            <td><strong>Minimum Roof Slope</strong></td>
            <td>{{ service.specifications.minimumSlope }}</td>
          </tr>
          <tr>
            <td><strong>Wind Resistance Rating</strong></td>
            <td>{{ service.windRating }}</td>
          </tr>
          <tr>
            <td><strong>Impact / Hail Resistance</strong></td>
            <td>{{ service.impactRating }}</td>
          </tr>
          <tr>
            <td><strong>Fire Safety Rating</strong></td>
            <td>{{ service.fireRating }}</td>
          </tr>
          <tr>
            <td><strong>Typical Installed Cost Range</strong></td>
            <td><a href="/roofing-costs/{{ service.costSlug }}/">{{ service.costRange }} (Detailed Cost Guide)</a></td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Pros & Cons Breakdown -->
    <h2>Pros and Cons of {{ service.material }} Shingles</h2>
    <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin: 1.5rem 0 2.5rem 0;">
      <div style="background: var(--color-success-bg); border: 1.5px solid #86efac; border-radius: var(--radius-md); padding: 1.5rem;">
        <h3 style="color: #166534; margin-top: 0; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Advantages
        </h3>
        <ul style="padding-left: 1.25rem; color: #14532d; display: flex; flex-direction: column; gap: 0.5rem;">
          {% for pro in service.pros %}
          <li>{{ pro }}</li>
          {% endfor %}
        </ul>
      </div>

      <div style="background: var(--color-warning-bg); border: 1.5px solid #fde68a; border-radius: var(--radius-md); padding: 1.5rem;">
        <h3 style="color: #92400e; margin-top: 0; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          Considerations & Drawbacks
        </h3>
        <ul style="padding-left: 1.25rem; color: #78350f; display: flex; flex-direction: column; gap: 0.5rem;">
          {% for con in service.cons %}
          <li>{{ con }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <!-- Material Comparison Section -->
    <h2>Comparing {{ service.material }} to Alternative Shingle Materials</h2>
    <p>Before committing to an installation, explore how {{ service.material }} compares to popular alternative roofing choices:</p>
    <div style="display: grid; grid-template-columns: 1fr; gap: 1.25rem; margin: 1.5rem 0 2.5rem 0;">
      <div class="callout-box">
        <h3 style="margin-top: 0;"><a href="/services/{{ service.comparison.alt1.slug }}/">{{ service.comparison.alt1.name }}</a></h3>
        <p>{{ service.comparison.alt1.note }}</p>
      </div>
      <div class="callout-box">
        <h3 style="margin-top: 0;"><a href="/services/{{ service.comparison.alt2.slug }}/">{{ service.comparison.alt2.name }}</a></h3>
        <p>{{ service.comparison.alt2.note }}</p>
      </div>
    </div>

    <!-- Pricing Callout -->
    <div class="callout-box callout-box-accent">
      <h3>Planning Your {{ service.material }} Roofing Budget?</h3>
      <p>
        Installed investment for {{ service.material | lower }} shingles ranges from <strong>{{ service.costRange }}</strong>. Pricing factors include roof square footage, slope pitch complexity, tear-off layer disposal, and plywood deck repairs.
      </p>
      <a href="/roofing-costs/{{ service.costSlug }}/" class="btn btn-primary" style="margin-top: 0.5rem;">
        View Complete {{ service.material }} Roof Cost Guide
      </a>
    </div>

    <!-- FAQs Section -->
    <h2>Frequently Asked Questions About {{ service.material }} Shingle Installation</h2>
    <div class="faq-list">
      {% for faq in service.faqs %}
      <details class="faq-item">
        <summary class="faq-summary">{{ faq.q }}</summary>
        <div class="faq-content">
          <p>{{ faq.a }}</p>
        </div>
      </details>
      {% endfor %}
    </div>

    <!-- Final Call to Action -->
    <div style="background: var(--color-primary); color: #ffffff; padding: 2.5rem; border-radius: var(--radius-lg); text-align: center; margin-top: 3rem;">
      <h2 style="color: #ffffff; margin-top: 0;">Ready for a Professional {{ service.name }}?</h2>
      <p style="color: #cbd5e1; max-width: 600px; margin: 0 auto 1.5rem auto;">
        We match you with licensed and insured independent roofing specialists in your community. Fast telephone connection during business hours, with average partner response time in {{ site.responseTime }}.
      </p>
      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="tel:{{ site.phoneTel }}" class="btn btn-primary" style="font-size: 1.15rem; padding: 0.95rem 2rem;">
          Call (833) 348-0328
        </a>
        <a href="/states/" class="btn btn-secondary">
          Find Local Contractors
        </a>
      </div>
    </div>

  </div>
</section>
